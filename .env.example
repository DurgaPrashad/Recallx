# ─────────────────────────────────────────────────────────────────
# Recall-X environment configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────

# ---- Hindsight (persistent memory) -------------------------------
# Recall-X talks to a running Hindsight server via the official
# @vectorize-io/hindsight-client SDK. Run Hindsight locally with Docker:
#
#   docker run -it --pull always --name hindsight --restart unless-stopped \
#     -p 8888:8888 -p 9999:9999 \
#     -e HINDSIGHT_API_LLM_API_KEY=$ANTHROPIC_API_KEY \
#     -e HINDSIGHT_API_LLM_PROVIDER=anthropic \
#     -v hindsight-data:/home/hindsight/.pg0 \
#     ghcr.io/vectorize-io/hindsight:latest
#
# API -> http://localhost:8888   UI -> http://localhost:9999
HINDSIGHT_API_URL=http://localhost:8888
# Only needed if your Hindsight deployment enforces auth (e.g. Hindsight Cloud)
HINDSIGHT_API_KEY=
# Memory bank Recall-X reads/writes. Created automatically on first run.
HINDSIGHT_BANK_ID=recallx

# ---- Recall-X reasoning LLM ----------------------------------------
# Used to synthesize the Recall-X Brief (probable cause / check first /
# don't-try-again / what-worked) from Hindsight recall evidence, and as the
# fallback path for Ask Recall-X. Falls back to deterministic rule-based
# synthesis if unset or unreachable, so the app stays demoable either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Local data store -----------------------------------------------
# Recall-X keeps live incident/operational state (the "system of record")
# in a local SQLite file. Hindsight is the "memory" layer built on top.
DATABASE_PATH=./data/recallx.db

# ---- Demo / dev ------------------------------------------------------
# Set to true to force Recall-X into fallback mode even if Hindsight is
# reachable — useful for demoing graceful degradation.
SKIP_HINDSIGHT=false
